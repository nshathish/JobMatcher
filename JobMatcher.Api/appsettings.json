{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JobMatcher.Application.Jobs.JobExtractionService": "Debug",
      "JobMatcher.Infrastructure.Jobs": "Information"
    }
  },
  "JobExtraction": {
    "TotalTimeoutSeconds": 45,
    "HttpTimeoutSeconds": 15,
    "BrowserTimeoutSeconds": 30,
    "MaxResponseBytes": 5000000,
    "MaxConcurrentExtractions": 4,
    "MaxRedirects": 0
  },
  "AllowedHosts": "*"
}
